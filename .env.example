# Appwrite Configuration
# Get these values from your Appwrite project dashboard
APPWRITE_ENDPOINT=https://your-region.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_USERS_COLLECTION_ID=users
APPWRITE_QUESTIONS_COLLECTION_ID=questions
APPWRITE_LEADERBOARD_COLLECTION_ID=leaderboard
APPWRITE_LEVELS_COLLECTION_ID=levels
APPWRITE_USER_PROGRESS_COLLECTION_ID=user_progress
APPWRITE_STORAGE_BUCKET_ID=your_storage_bucket_id

# OAuth Providers
# Get these from respective developer consoles
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
FACEBOOK_APP_ID=your_facebook_app_id
TWITTER_CLIENT_ID=your_twitter_client_id

# OpenAI API Key
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# AI Service (OpenAI or similar)
AI_API_KEY=sk-proj-your_ai_api_key_here
AI_API_ENDPOINT=https://api.openai.com/v1