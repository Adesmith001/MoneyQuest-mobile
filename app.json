{
  "expo": {
    "name": "MoneyQuest",
    "slug": "moneyquest",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/logo-white.png",
    "scheme": "moneyquest",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expo.moneyquest",
      "buildNumber": "1.1.1",
      "jsEngine": "hermes",
      "newArchEnabled": false,
      "entitlements": {
        "com.apple.developer.game-center": true
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.expo.moneyquest",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-orange.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "moneyquest",
              "host": "*"
            },
            {
              "scheme": "https",
              "host": "moneyquest.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo-white.png",
      "name": "MoneyQuest",
      "shortName": "MoneyQuest",
      "description": "MoneyQuest — learn money skills through fun, bite-sized lessons.",
      "lang": "en",
      "themeColor": "#FF6B35",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/",
      "id": "/",
      "icons": [
        {
          "source": "./public/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "source": "./public/icons/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        },
        {
          "source": "./public/icons/maskable-512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "maskable"
        }
      ],
      "appleTouchIcon": "./public/icons/icon-192.png"
    },
    "extra": {
      "eas": {
        "projectId": "6dcf413d-e595-4507-9374-30c460ddf8d7"
      },
      "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
      "APPWRITE_PROJECT_ID": "68cc6ab300330cae9c56",
      "APPWRITE_DATABASE_ID": "68cc891e001ebcafceeb"
    },
    "owner": "adesmith",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "newArchEnabled": false,
            "flipper": false
          },
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ArialRoundedMTBold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-white.png",
          "color": "#FF6B35",
          "sounds": []
        }
      ]
    ]
  }
}
