{
  "expo": {
    "name": "MoneyQuest",
    "slug": "moneyquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-black.png",
    "scheme": "moneyquest",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expo.moneyquest",
      "buildNumber": "1.0.0",
      "deploymentTarget": "13.0",
      "jsEngine": "hermes",
      "newArchEnabled": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "MoneyQuest needs access to your photo library to let you choose a profile picture.",
        "NSCameraUsageDescription": "MoneyQuest needs access to your camera to take profile pictures.",
        "NSMicrophoneUsageDescription": "MoneyQuest uses audio to provide text-to-speech for questions and explanations.",
        "NSUserTrackingUsageDescription": "MoneyQuest uses this to provide a better learning experience.",
        "NSLocationWhenInUseUsageDescription": "MoneyQuest needs your location to personalize your learning experience.",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.expo.moneyquest",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-black.png",
        "backgroundColor": "#ffffff"
      },
      "notification": {
        "icon": "./assets/logo-black.png",
        "color": "#FF6B35"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "moneyquest",
              "host": "*"
            },
            {
              "scheme": "https",
              "host": "moneyquest.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive",
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6dcf413d-e595-4507-9374-30c460ddf8d7"
      },
      "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
      "APPWRITE_PROJECT_ID": "68cc6ab300330cae9c56",
      "APPWRITE_DATABASE_ID": "68cc891e001ebcafceeb",
      "MONEYQUEST_API_BASE_URL": "https://moneyquestproject-demo-production.up.railway.app"
    },
    "owner": "adesmith",
    "privacyPolicyUrl": "https://www.nurtureehaven.com/privacy-policy",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": false,
            "flipper": false
          },
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ArialRoundedMTBold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-black.png",
          "color": "#FF6B35",
          "sounds": []
        }
      ]
    ]
  }
}
