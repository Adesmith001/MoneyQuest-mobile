{
  "expo": {
    "name": "MoneyQuest",
    "slug": "moneyquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-black.png",
    "scheme": "moneyquest",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expo.moneyquest",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.expo.moneyquest",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-black.png",
        "backgroundColor": "#ffffff"
      },
      "notification": {
        "icon": "./assets/logo-black.png",
        "color": "#FF6B35"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "moneyquest",
              "host": "*"
            },
            {
              "scheme": "https",
              "host": "moneyquest.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive",
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6dcf413d-e595-4507-9374-30c460ddf8d7"
      }
    },
    "owner": "adesmith",
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ArialRoundedMTBold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-black.png",
          "color": "#FF6B35",
          "sounds": []
        }
      ]
    ]
  }
}
