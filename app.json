{
  "expo": {
    "name": "MoneyQuest",
    "slug": "moneyquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-black.png",
    "scheme": "moneyquest",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.expo.moneyquest",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-black.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "moneyquest"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive",
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      }
    },
    "extra": {
      "eas": {
        "projectId": "6dcf413d-e595-4507-9374-30c460ddf8d7"
      }
    },
    "owner": "adesmith",
    "plugins": [
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ArialRoundedMTBold.ttf"]
        }
      ]
    ]
  }
}
